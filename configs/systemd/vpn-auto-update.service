[Unit]
Description=VPN Auto Update from Git
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/multi-vpn-server
ExecStart=/opt/multi-vpn-server/scripts/auto-update.sh
StandardOutput=journal
StandardError=journal

# Restart policy
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target